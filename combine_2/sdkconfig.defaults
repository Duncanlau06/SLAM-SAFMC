# Use large factory partition — firmware binary exceeds 1MB default
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y

# Allow task pinning to specific cores
CONFIG_FREERTOS_UNICORE=n

# UART ISR in IRAM so WiFi cache misses don't stall it
CONFIG_UART_ISR_IN_IRAM=y

# Stacks (main task + event task)
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=8192

# Tick rate — 1000Hz gives 1ms resolution for vTaskDelayUntil
CONFIG_FREERTOS_HZ=1000

# Drone configuration (per drone: change via menuconfig)
CONFIG_DRONE_ID=2
CONFIG_TOF_FRONT_SENSOR_IDX=1

# Octal PSRAM — required by SLAM (occ_grid.c allocates with MALLOC_CAP_SPIRAM)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MEMTEST=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768
CONFIG_FREERTOS_TASK_CREATE_ALLOW_EXT_MEM=y

# Performance: 240 MHz, -O2, larger caches
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
CONFIG_ESP32S3_RTCDATA_IN_FAST_MEM=y
CONFIG_PM_SLEEP_FUNC_IN_IRAM=y
CONFIG_PM_SLP_IRAM_OPT=y

# Watchdogs off (long SLAM optimisation blocks would trip them)
CONFIG_ESP_INT_WDT=n
CONFIG_ESP_TASK_WDT_EN=n

CONFIG_COMPILER_DISABLE_GCC12_WARNINGS=y
CONFIG_COMPILER_DISABLE_GCC13_WARNINGS=y
CONFIG_COMPILER_DISABLE_GCC14_WARNINGS=y
